{
  "name": "@defn/web",
  "version": "0.1.0",
  "description": "Defn web app: a PDF reader that links terms to their definitions.",
  "license": "MIT",
  "author": "aadi219",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aadi219/defn.git",
    "directory": "apps/web"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@defn/core": "workspace:*",
    "@defn/viewer": "workspace:*",
    "@floating-ui/react": "^0.27.20",
    "dexie": "^4.4.6",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
